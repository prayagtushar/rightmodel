{
  "name": "rightmodel",
  "version": "0.1.0",
  "description": "Routes each coding task to the cheapest capable model in the agent CLIs you already have.",
  "license": "MIT",
  "author": "Prayag Tushar",
  "homepage": "https://github.com/prayagtushar/rightmodel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prayagtushar/rightmodel.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/prayagtushar/rightmodel/issues"
  },
  "keywords": [
    "claude-code",
    "cli",
    "llm",
    "model-routing",
    "ai-agents",
    "cost-optimization"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rightmodel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node dist/cli.js bench"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
